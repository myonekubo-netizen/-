<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>撮影進捗管理</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=DM+Mono:wght@400;500&display=swap');

  :root {
    --bg: #f0f2f5;
    --surface: #ffffff;
    --surface2: #f5f6f8;
    --border: #dde0e8;
    --accent: #4f46e5;
    --accent3: #0891b2;
    --text: #1a1d2e;
    --text2: #5a6070;
    --text3: #9aa0b0;
    --ok: #16a34a;
    --warn: #b45309;
    --danger: #dc2626;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Noto Sans JP', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; font-size: 13px; }

  .header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 12px 20px; display: flex; align-items: center; gap: 16px; position: sticky; top: 0; z-index: 100; }
  .header-title { font-size: 15px; font-weight: 700; letter-spacing: 0.05em; }
  .header-title span { color: var(--accent); }
  .header-badges { display: flex; gap: 8px; margin-left: auto; flex-wrap: wrap; }
  .badge { background: var(--surface2); border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; font-size: 11px; font-family: 'DM Mono', monospace; display: flex; gap: 6px; align-items: center; }
  .badge b { color: var(--accent); }
  .badge.warn b { color: var(--warn); }
  .badge.danger b { color: var(--danger); }
  .badge.ok b { color: var(--ok); }

  .tabs { display: flex; gap: 2px; padding: 12px 20px 0; border-bottom: 1px solid var(--border); background: var(--surface); flex-wrap: wrap; }
  .tab { padding: 8px 16px; border-radius: 6px 6px 0 0; cursor: pointer; font-size: 12px; font-weight: 500; color: var(--text2); border: 1px solid transparent; border-bottom: none; transition: all 0.15s; background: transparent; }
  .tab:hover { color: var(--text); background: var(--surface2); }
  .tab.active { color: var(--accent); background: var(--bg); border-color: var(--border); border-bottom-color: var(--bg); }

  .filters { padding: 12px 20px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; background: var(--bg); }
  .filter-select, .filter-input { background: #fff; border: 1px solid var(--border); color: var(--text); border-radius: 6px; padding: 6px 10px; font-size: 12px; font-family: 'Noto Sans JP', sans-serif; outline: none; }
  .filter-select:focus, .filter-input:focus { border-color: var(--accent); }
  .filter-btn { padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface); color: var(--text2); font-size: 12px; cursor: pointer; transition: all 0.15s; font-family: 'Noto Sans JP', sans-serif; }
  .filter-btn:hover, .filter-btn.active { background: var(--accent); color: white; border-color: var(--accent); }
  .csv-btn { padding: 6px 14px; background: #16a34a; color: white; border: none; border-radius: 6px; font-size: 12px; cursor: pointer; font-family: 'Noto Sans JP', sans-serif; font-weight: 500; }
  .csv-btn:hover { background: #15803d; }
  .add-btn { margin-left: auto; padding: 6px 14px; background: var(--accent); color: white; border: none; border-radius: 6px; font-size: 12px; cursor: pointer; font-family: 'Noto Sans JP', sans-serif; font-weight: 500; }
  .add-btn:hover { background: #4338ca; }

  .table-wrap { padding: 0 20px 20px; overflow-x: auto; }
  table { width: 100%; border-collapse: separate; border-spacing: 0 4px; min-width: 900px; }
  thead th { padding: 8px 10px; text-align: left; font-size: 10px; font-weight: 600; letter-spacing: 0.08em; color: var(--text3); text-transform: uppercase; white-space: nowrap; }
  tbody tr { background: var(--surface); transition: background 0.1s; }
  tbody tr:hover { background: var(--surface2); }
  tbody td { padding: 9px 10px; vertical-align: middle; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  tbody td:first-child { border-left: 1px solid var(--border); border-radius: 8px 0 0 8px; }
  tbody td:last-child { border-right: 1px solid var(--border); border-radius: 0 8px 8px 0; }

  .fac { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; letter-spacing: 0.03em; white-space: nowrap; }
  .fac-8F { background: #dbeafe; color: #1d4ed8; }
  .fac-8C { background: #dcfce7; color: #15803d; }
  .fac-3SH { background: #fee2e2; color: #b91c1c; }
  .fac-3SA { background: #f3e8ff; color: #7e22ce; }
  .fac-KH { background: #fef3c7; color: #b45309; }
  .fac-8L { background: #cffafe; color: #0e7490; }

  .st { display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 4px; font-size: 11px; white-space: nowrap; }
  .st-done { background: #dcfce7; color: #15803d; }
  .st-pending { background: #fef3c7; color: #b45309; }
  .st-none { background: var(--surface2); color: var(--text3); }
  .st-waiting { background: #e0e7ff; color: #4338ca; }
  .st-skip { background: #f0f9ff; color: #0369a1; }

  .amount { font-family: 'DM Mono', monospace; font-size: 12px; white-space: nowrap; }
  .amount-cam { color: var(--accent); }
  .amount-model { color: var(--accent3); }
  .amount-zero { color: var(--text3); }
  .date-col { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--text2); white-space: nowrap; }
  .type-col { color: var(--text2); font-size: 11px; }
  .model-col { font-size: 11px; color: var(--text2); }
  .note-col { font-size: 11px; color: var(--text3); max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-radius: 4px; padding: 2px 4px; }
  .note-col:focus { outline: 2px solid var(--accent); color: var(--text); white-space: normal; overflow: visible; background: #fff; }
  .delivery-col { font-size: 11px; color: var(--text2); max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .edit-btn, .del-btn { padding: 3px 8px; border-radius: 4px; border: 1px solid var(--border); background: transparent; color: var(--text3); font-size: 11px; cursor: pointer; transition: all 0.15s; }
  .edit-btn:hover { color: var(--accent); border-color: var(--accent); }
  .del-btn:hover { color: var(--danger); border-color: var(--danger); }

  /* MODAL */
  .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 200; align-items: center; justify-content: center; }
  .overlay.open { display: flex; }
  .modal { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px; width: 560px; max-width: 95vw; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.15); }
  .modal-title { font-size: 15px; font-weight: 700; margin-bottom: 20px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .form-group { display: flex; flex-direction: column; gap: 4px; }
  .form-group.full { grid-column: 1 / -1; }
  label { font-size: 11px; color: var(--text2); }
  input, select, textarea { background: #fff; border: 1px solid var(--border); color: var(--text); border-radius: 6px; padding: 7px 10px; font-size: 12px; font-family: 'Noto Sans JP', sans-serif; outline: none; width: 100%; }
  input:focus, select:focus, textarea:focus { border-color: var(--accent); }
  .form-section { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
  .form-section-title { font-size: 11px; color: var(--text3); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px; }
  .status-item { display: flex; align-items: center; justify-content: space-between; padding: 6px 10px; background: var(--surface2); border-radius: 6px; margin-bottom: 6px; }
  .status-item label { font-size: 12px; color: var(--text); margin: 0; }
  .status-toggle { display: flex; gap: 2px; }
  .stbtn { padding: 3px 10px; border-radius: 4px; border: 1px solid var(--border); background: transparent; font-size: 11px; cursor: pointer; color: var(--text3); font-family: 'Noto Sans JP', sans-serif; transition: all 0.1s; }
  .stbtn.active-done { background: #dcfce7; color: #15803d; border-color: #86efac; }
  .stbtn.active-pending { background: #fef3c7; color: #b45309; border-color: #fcd34d; }
  .stbtn.active-skip { background: #f0f9ff; color: #0369a1; border-color: #7dd3fc; }
  .stbtn.active-none { background: var(--surface2); color: var(--text3); }
  .modal-actions { display: flex; gap: 8px; margin-top: 20px; justify-content: flex-end; }
  .btn-primary { padding: 8px 20px; background: var(--accent); color: white; border: none; border-radius: 6px; font-size: 13px; cursor: pointer; font-family: 'Noto Sans JP', sans-serif; }
  .btn-secondary { padding: 8px 16px; background: transparent; color: var(--text2); border: 1px solid var(--border); border-radius: 6px; font-size: 13px; cursor: pointer; font-family: 'Noto Sans JP', sans-serif; }

  /* SUMMARY */
  .summary-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; padding: 20px; }
  .summary-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
  .summary-card-title { font-size: 11px; color: var(--text3); margin-bottom: 6px; letter-spacing: 0.05em; }
  .summary-card-value { font-size: 22px; font-family: 'DM Mono', monospace; font-weight: 500; }
  .summary-card-value.accent { color: var(--accent); }
  .summary-card-value.warn { color: var(--warn); }
  .summary-card-value.ok { color: var(--ok); }
  .summary-card-value.danger { color: var(--danger); }

  /* FY TABS */
  .fy-tabs { display: flex; gap: 4px; margin-bottom: 16px; }
  .fy-tab { padding: 6px 16px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface); color: var(--text2); font-size: 12px; font-weight: 500; cursor: pointer; transition: all 0.15s; font-family: 'Noto Sans JP', sans-serif; }
  .fy-tab:hover { background: var(--surface2); }
  .fy-tab.active { background: var(--accent); color: white; border-color: var(--accent); }

  /* MONTHLY */
  .monthly-wrap { padding: 20px; }
  .month-block { margin-bottom: 16px; }
  .month-header { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; cursor: pointer; user-select: none; transition: background 0.1s; }
  .month-header:hover { background: var(--surface2); }
  .month-header.open { border-radius: 8px 8px 0 0; border-bottom-color: transparent; }
  .month-label { font-size: 14px; font-weight: 700; font-family: 'DM Mono', monospace; color: var(--accent); min-width: 80px; }
  .month-stats { font-size: 11px; color: var(--text2); display: flex; gap: 14px; flex-wrap: wrap; }
  .month-toggle { color: var(--text3); font-size: 11px; margin-left: auto; transition: transform 0.2s; display: inline-block; }
  .month-toggle.open { transform: rotate(180deg); }
  .month-body { border: 1px solid var(--border); border-top: none; border-radius: 0 0 8px 8px; overflow: hidden; display: none; }
  .month-body.open { display: block; }
  .month-body table { min-width: 700px; border-spacing: 0; }
  .month-body thead th { background: var(--surface2); }
  .month-body tbody tr { background: var(--surface); }
  .month-body tbody tr:nth-child(even) { background: var(--surface2); }
  .month-body tbody td { border: none; border-bottom: 1px solid var(--border); border-radius: 0 !important; border-left: none !important; border-right: none !important; }
  .month-body tbody tr:last-child td { border-bottom: none; }
  .month-body tbody tr:hover { background: #eef0ff; }

  /* PAYMENT CYCLE */
  .payment-wrap { padding: 20px; }
  .pay-cam-block { margin-bottom: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .pay-cam-header { padding: 14px 16px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--border); background: var(--surface2); flex-wrap: wrap; }
  .pay-cam-name { font-size: 15px; font-weight: 700; }
  .pay-cam-total { margin-left: auto; font-family: 'DM Mono', monospace; font-size: 14px; color: var(--accent); font-weight: 600; }
  .pay-cycles { padding: 12px 16px; display: flex; flex-direction: column; gap: 12px; }
  .pay-cycle { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .pay-cycle-header { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: var(--surface2); border-bottom: 1px solid var(--border); flex-wrap: wrap; }
  .cycle-label { font-size: 12px; font-weight: 600; color: var(--text); }
  .cycle-amount { font-family: 'DM Mono', monospace; font-size: 13px; color: var(--accent); }
  .cycle-status { margin-left: auto; }
  .cycle-paid { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 4px; font-size: 11px; background: #dcfce7; color: #15803d; }
  .cycle-unpaid { display: inline-flex; align-items: center; gap: 4px; padding: 4px 12px; border-radius: 4px; font-size: 11px; background: #fef3c7; color: #b45309; cursor: pointer; border: 1px solid #fcd34d; font-family: 'Noto Sans JP', sans-serif; transition: background 0.15s; }
  .cycle-unpaid:hover { background: #fde68a; }
  .cycle-items { padding: 4px 0; }
  .cycle-item { display: flex; align-items: center; gap: 10px; padding: 7px 14px; font-size: 12px; color: var(--text2); border-bottom: 1px solid var(--border); }
  .cycle-item:last-child { border-bottom: none; }
  .cycle-item .ci-date { font-family: 'DM Mono', monospace; font-size: 11px; width: 55px; flex-shrink: 0; }
  .ci-edit-item { padding: 2px 6px; border: 1px solid var(--border); background: transparent; border-radius: 4px; color: var(--text3); font-size: 10px; cursor: pointer; margin-left: auto; }
  .ci-edit-item:hover { color: var(--accent); border-color: var(--accent); }
  .ci-del-item { padding: 2px 6px; border: 1px solid var(--border); background: transparent; border-radius: 4px; color: var(--text3); font-size: 10px; cursor: pointer; }
  .ci-del-item:hover { color: var(--danger); border-color: var(--danger); }
  .add-cycle-btn { margin: 0 16px 14px; padding: 7px 14px; background: transparent; border: 1px dashed var(--border); border-radius: 6px; color: var(--text3); font-size: 12px; cursor: pointer; width: calc(100% - 32px); font-family: 'Noto Sans JP', sans-serif; transition: all 0.15s; }
  .add-cycle-btn:hover { border-color: var(--accent); color: var(--accent); background: #eef0ff; }
  .add-cam-btn { margin: 0 20px 20px; padding: 8px 16px; background: transparent; border: 1px dashed var(--border); border-radius: 8px; color: var(--text3); font-size: 12px; cursor: pointer; font-family: 'Noto Sans JP', sans-serif; transition: all 0.15s; }
  .add-cam-btn:hover { border-color: var(--accent); color: var(--accent); }

  .empty { padding: 40px; text-align: center; color: var(--text3); font-size: 13px; }
  .cam-table { padding: 20px; }
</style>
</head>
<body>

<div class="header">
  <div class="header-title">📷 <span>撮影</span>進捗管理</div>
  <div class="header-badges">
    <div class="badge danger"><span>稟議未</span><b id="badge-ringi">0</b></div>
    <div class="badge warn"><span>振込未</span><b id="badge-furikomi">0</b></div>
    <div class="badge"><span>納品待ち</span><b id="badge-delivery">0</b></div>
    <div class="badge ok"><span>総件数</span><b id="badge-total">0</b></div>
  </div>
</div>

<div class="tabs">
  <div class="tab active" onclick="switchTab('list')">案件一覧</div>
  <div class="tab" onclick="switchTab('monthly')">月別アーカイブ</div>
  <div class="tab" onclick="switchTab('payment')">支払いサイクル</div>
  <div class="tab" onclick="switchTab('summary')">サマリー</div>
  <div class="tab" onclick="switchTab('camera')">カメラマン別</div>
</div>

<!-- LIST TAB -->
<div id="tab-list">
  <div class="filters">
    <select class="filter-select" id="f-facility" onchange="renderList()">
      <option value="">施設 すべて</option>
      <option>8F</option><option>8C</option><option>3SH</option><option>3SA</option><option>KH</option><option>8L</option>
    </select>
    <select class="filter-select" id="f-cam" onchange="renderList()">
      <option value="">カメラマン すべて</option>
    </select>
    <select class="filter-select" id="f-type" onchange="renderList()">
      <option value="">種別 すべて</option>
      <option>SNS</option><option>マルシェ</option><option>夜スパ</option><option>5周年</option>
    </select>
    <select class="filter-select" id="f-fy" onchange="renderList()">
      <option value="">年度 すべて</option>
    </select>
    <button class="filter-btn" id="fb-pending" onclick="togglePending()">未処理のみ</button>
    <input class="filter-input" id="f-search" placeholder="🔍 検索..." oninput="renderList()" style="width:130px">
    <button class="filter-btn" onclick="resetListFilters()">✕ リセット</button>
    <button class="csv-btn" onclick="exportCSV()">↓ CSV出力</button>
    <button class="add-btn" onclick="openModal()">＋ 新規追加</button>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>日付</th><th>施設</th><th>種別</th><th>カメラマン</th>
          <th>金額(税抜)</th><th>稟議</th><th>振込</th><th>請求書</th><th>経理</th><th>支払確認</th>
          <th>モデル</th><th>モデル金額(税込)</th><th>モデル稟議</th><th>モデル請求書</th><th>モデル支払</th>
          <th>納品</th><th>備考</th><th></th>
        </tr>
      </thead>
      <tbody id="tbody"></tbody>
    </table>
    <div id="empty-msg" class="empty" style="display:none">該当する案件がありません</div>
  </div>
</div>

<!-- MONTHLY TAB -->
<div id="tab-monthly" style="display:none">
  <div class="filters">
    <select class="filter-select" id="mf-facility" onchange="renderMonthly()">
      <option value="">施設 すべて</option>
      <option>8F</option><option>8C</option><option>3SH</option><option>3SA</option><option>KH</option><option>8L</option>
    </select>
    <select class="filter-select" id="mf-cam" onchange="renderMonthly()">
      <option value="">カメラマン すべて</option>
    </select>
    <select class="filter-select" id="mf-type" onchange="renderMonthly()">
      <option value="">種別 すべて</option>
    </select>
    <button class="filter-btn" onclick="resetMonthlyFilters()">✕ リセット</button>
  </div>
  <div class="monthly-wrap" id="monthly-wrap"></div>
</div>

<!-- PAYMENT TAB -->
<div id="tab-payment" style="display:none">
  <div class="filters">
    <select class="filter-select" id="pf-cam" onchange="renderPayment()">
      <option value="">カメラマン すべて</option>
    </select>
    <button class="filter-btn" id="pfb-unpaid" onclick="togglePayPending()">未払いのみ</button>
    <button class="filter-btn" onclick="resetPaymentFilters()">✕ リセット</button>
  </div>
  <div class="payment-wrap" id="payment-wrap"></div>
</div>

<!-- SUMMARY TAB -->
<div id="tab-summary" style="display:none">
  <div class="filters">
    <select class="filter-select" id="sf-fy" onchange="renderSummary()">
      <option value="">年度 すべて</option>
    </select>
    <select class="filter-select" id="sf-facility" onchange="renderSummary()">
      <option value="">施設 すべて</option>
      <option>8F</option><option>8C</option><option>3SH</option><option>3SA</option><option>KH</option><option>8L</option>
    </select>
    <button class="filter-btn" onclick="resetSummaryFilters()">✕ リセット</button>
  </div>
  <div class="summary-grid" id="summary-grid"></div>
</div>

<!-- CAMERA TAB -->
<div id="tab-camera" style="display:none">
  <div class="filters">
    <select class="filter-select" id="cf-fy" onchange="renderCamera()">
      <option value="">年度 すべて</option>
    </select>
    <select class="filter-select" id="cf-facility" onchange="renderCamera()">
      <option value="">施設 すべて</option>
      <option>8F</option><option>8C</option><option>3SH</option><option>3SA</option><option>KH</option><option>8L</option>
    </select>
    <button class="filter-btn" onclick="resetCameraFilters()">✕ リセット</button>
  </div>
  <div class="cam-table">
    <table>
      <thead>
        <tr><th>カメラマン</th><th>件数</th><th>費用合計(税抜)</th><th>モデル費用(税込)</th><th>稟議未</th><th>振込未</th><th>納品待ち</th></tr>
      </thead>
      <tbody id="cam-tbody"></tbody>
    </table>
  </div>
</div>

<!-- MODAL -->
<div class="overlay" id="overlay" onclick="closeModalBg(event)">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-title" id="modal-title">新規案件追加</div>
    <div class="form-grid">
      <div class="form-group"><label>日付</label><input type="date" id="m-date"></div>
      <div class="form-group"><label>施設</label>
        <select id="m-facility"><option>8F</option><option>8C</option><option>3SH</option><option>3SA</option><option>KH</option><option>8L</option></select>
      </div>
      <div class="form-group"><label>種別</label>
        <select id="m-type" onchange="handleTypeSelect(this)">
          <option value="">選択してください</option>
        </select>
        <input id="m-type-custom" placeholder="種別を入力" style="margin-top:4px;display:none">
      </div>
      <div class="form-group"><label>カメラマン</label>
        <select id="m-cam" onchange="handleCamSelect(this)">
          <option value="">選択してください</option>
        </select>
        <input id="m-cam-custom" placeholder="名前を入力" style="margin-top:4px;display:none">
      </div>
      <div class="form-group"><label>カメラマン費用（税抜）</label><input type="number" id="m-camfee" value="0"></div>
      <div class="form-group"><label>モデル名</label>
