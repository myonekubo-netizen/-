let payPendingOnly = false;
function togglePayPending() {
  payPendingOnly = !payPendingOnly;
  document.getElementById('pfb-unpaid').classList.toggle('active', payPendingOnly);
  renderPayment();
}

function renderPayment() {
  const wrap = document.getElementById('payment-wrap');
  const pfCam = document.getElementById('pf-cam') ? document.getElementById('pf-cam').value : '';
  let allCams = Object.keys(payCycles);
  if (pfCam) allCams = allCams.filter(c => c === pfCam);
  if (payPendingOnly) allCams = allCams.filter(c => payCycles[c].some(cy=>!cy.paid));
  if (!allCams.length) { wrap.innerHTML = '<div class="empty">該当するカメラマンがありません</div>'; return; }

  wrap.innerHTML = allCams.map(cam => {
    const cycles = payCycles[cam];
    const totalPaid = cycles.filter(c=>c.paid).reduce((s,c)=>s+c.amount,0);
    const totalUnpaid = cycles.filter(c=>!c.paid).reduce((s,c)=>s+c.amount,0);
    const cycleHTML = cycles.map((cycle, ci) => {
      const itemHTML = cycle.items.map((item, ii) => `
        <div class="cycle-item">
          <span class="ci-date">${item.slice(5,10)}</span>
          <span style="flex:1">${item.slice(11)||item}</span>
          <button class="ci-edit-item" onclick="editItemInCycle('${cam}',${ci},${ii})">編集</button>
          <button class="ci-del-item" onclick="removeItemFromCycle('${cam}',${ci},${ii})">✕</button>
        </div>`).join('') +
        `<div class="cycle-item" style="cursor:pointer;color:var(--text3);font-size:11px" onclick="addItemToCycle('${cam}',${ci})">＋ 案件を追加</div>`;
      return `<div class="pay-cycle">
        <div class="pay-cycle-header">
          <span class="cycle-label">${cycle.label}</span>
          <span class="cycle-amount">¥${cycle.amount.toLocaleString()}</span>
          <span class="cycle-status">
            ${cycle.paid
              ? `<button class="cycle-unpaid" style="background:#f1f5f9;color:var(--text3);border-color:var(--border)" onclick="markCycleUnpaid('${cam}',${ci})">✓ 支払済 (取消)</button>`
              : `<button class="cycle-unpaid" onclick="markCyclePaid('${cam}',${ci})">未払い → 済にする</button>`}
          </span>
          <button class="edit-btn" onclick="editCycle('${cam}',${ci})">編集</button>
          <button class="del-btn" onclick="deleteCycle('${cam}',${ci})">削除</button>
        </div>
        <div class="cycle-items">${itemHTML}</div>
      </div>`;
    }).join('');

    return `<div class="pay-cam-block">
      <div class="pay-cam-header">
        <span class="pay-cam-name">📷 ${cam}</span>
        <span style="font-size:11px;color:var(--text2)">
          支払済 <span style="color:var(--ok);font-weight:600">¥${totalPaid.toLocaleString()}</span>
          &nbsp;未払い <span style="color:var(--warn);font-weight:600">¥${totalUnpaid.toLocaleString()}</span>
        </span>
        <span class="pay-cam-total">合計 ¥${(totalPaid+totalUnpaid).toLocaleString()}</span>
        <button class="del-btn" onclick="deleteCam('${cam}')" style="margin-left:8px">カメラマン削除</button>
      </div>
      <div class="pay-cycles">${cycleHTML}</div>
      <button class="add-cycle-btn" onclick="addCycle('${cam}')">＋ 支払いサイクルを追加</button>
    </div>`;
  }).join('') +
  `<button class="add-cam-btn" onclick="addCam()">＋ カメラマンを追加</button>`;
}

function markCyclePaid(cam, ci) { payCycles[cam][ci].paid=true; saveData(); renderPayment(); }
function markCycleUnpaid(cam, ci) { if(!confirm('支払済を未払いに戻しますか？')) return; payCycles[cam][ci].paid=false; saveData(); renderPayment(); }
function deleteCycle(cam, ci) { if(!confirm('このサイクルを削除しますか？')) return; payCycles[cam].splice(ci,1); saveData(); renderPayment(); }
function editCycle(cam, ci) {
  const cycle = payCycles[cam][ci];
  const label = prompt('サイクル名を変更', cycle.label); if(label===null) return;
  const amountStr = prompt('金額（税抜）を変更', String(cycle.amount)); if(amountStr===null) return;
  const amount = parseInt(amountStr);
  if(label.trim()) cycle.label = label.trim();
  if(!isNaN(amount)) cycle.amount = amount;
  saveData(); renderPayment();
}
function addCycle(cam) {
  const label = prompt('サイクル名（例: 第4回 ¥90,000）'); if(!label) return;
  const amount = parseInt(prompt('金額（税抜）', '90000'))||0;
  payCycles[cam].push({label,amount,paid:false,items:[]}); saveData(); renderPayment();
}
function addItemToCycle(cam, ci) {
  const item = prompt('案件を入力（例: 2026-06-01 8F SNS）'); if(!item) return;
  payCycles[cam][ci].items.push(item); saveData(); renderPayment();
}
function editItemInCycle(cam, ci, ii) {
  const current = payCycles[cam][ci].items[ii];
  const val = prompt('案件テキストを編集', current); if(val===null) return;
  if(val.trim()) payCycles[cam][ci].items[ii] = val.trim();
  saveData(); renderPayment();
}
function removeItemFromCycle(cam, ci, ii) { payCycles[cam][ci].items.splice(ii,1); saveData(); renderPayment(); }
function addCam() {
  const name = prompt('カメラマン名を入力'); if(!name||!name.trim()) return;
  if(!payCycles[name.trim()]) payCycles[name.trim()]=[];
  saveData(); renderPayment();
}
function deleteCam(cam) {
  if(!confirm(`「${cam}」のサイクルデータをすべて削除しますか？`)) return;
  delete payCycles[cam]; saveData(); renderPayment();
}

// ============================================================
// SUMMARY
// ============================================================
function renderSummary() {
  const sfFy = document.getElementById('sf-fy') ? parseInt(document.getElementById('sf-fy').value)||0 : 0;
  const sfFac = document.getElementById('sf-facility') ? document.getElementById('sf-facility').value : '';
  const sdata = data.filter(d => {
    if (sfFy && getFiscalYear(d.date.slice(0,7)) !== sfFy) return false;
    if (sfFac && d.fac !== sfFac) return false;
    return true;
  });
  const totalCam = sdata.reduce((s,d)=>s+d.camFee,0);
  const totalModel = sdata.reduce((s,d)=>s+d.modelFee,0);
  const facMap = {};
  sdata.forEach(d=>{ if(!facMap[d.fac]) facMap[d.fac]={count:0,cam:0,model:0}; facMap[d.fac].count++; facMap[d.fac].cam+=d.camFee; facMap[d.fac].model+=d.modelFee; });
  const ringi=sdata.filter(d=>d.cam_s[0]==='pending').length;
  const furi=sdata.filter(d=>d.cam_s[1]==='pending'||d.cam_s[1]==='waiting').length;
  const delPend=sdata.filter(d=>d.delivery&&d.delivery.includes('未')).length;
  const mPay=sdata.filter(d=>d.mod_s[3]==='pending').length;
  let html = `
    <div class="summary-card"><div class="summary-card-title">カメラマン費用合計（税抜）</div><div class="summary-card-value accent">¥${totalCam.toLocaleString()}</div></div>
    <div class="summary-card"><div class="summary-card-title">モデル費用合計（税込）</div><div class="summary-card-value" style="color:var(--accent3)">¥${totalModel.toLocaleString()}</div></div>
    <div class="summary-card"><div class="summary-card-title">稟議 未処理</div><div class="summary-card-value ${ringi>0?'danger':'ok'}">${ringi}件</div></div>
    <div class="summary-card"><div class="summary-card-title">振込依頼 未処理</div><div class="summary-card-value ${furi>0?'warn':'ok'}">${furi}件</div></div>
    <div class="summary-card"><div class="summary-card-title">納品待ち</div><div class="summary-card-value ${delPend>0?'warn':'ok'}">${delPend}件</div></div>
    <div class="summary-card"><div class="summary-card-title">モデル支払い未</div><div class="summary-card-value ${mPay>0?'danger':'ok'}">${mPay}件</div></div>
    <div class="summary-card"><div class="summary-card-title">総案件数</div><div class="summary-card-value">${sdata.length}件</div></div>`;
  Object.entries(facMap).sort((a,b)=>b[1].cam-a[1].cam).forEach(([fac,v])=>{
    html+=`<div class="summary-card"><div class="summary-card-title">${fac} (${v.count}件)</div><div style="margin:4px 0">${facChip(fac)}</div><div class="summary-card-value" style="font-size:16px;color:var(--text)">¥${v.cam.toLocaleString()}</div><div style="font-size:11px;color:var(--text3);margin-top:2px">モデル ¥${v.model.toLocaleString()}</div></div>`;
  });
  document.getElementById('summary-grid').innerHTML = html;
}

// ============================================================
// CAMERA TAB
// ============================================================
function renderCamera() {
  const cfFy = document.getElementById('cf-fy') ? parseInt(document.getElementById('cf-fy').value)||0 : 0;
  const cfFac = document.getElementById('cf-facility') ? document.getElementById('cf-facility').value : '';
  const cdata = data.filter(d => {
    if (cfFy && getFiscalYear(d.date.slice(0,7)) !== cfFy) return false;
    if (cfFac && d.fac !== cfFac) return false;
    return true;
  });
  const camMap = {};
  cdata.forEach(d=>{
    d.cam.split('・').forEach(c=>{
      c=c.trim(); if(!c) return;
      if(!camMap[c]) camMap[c]={count:0,cam:0,model:0,ringi:0,furi:0,delivery:0};
      camMap[c].count++; camMap[c].cam+=d.camFee; camMap[c].model+=d.modelFee;
      if(d.cam_s[0]==='pending') camMap[c].ringi++;
      if(d.cam_s[1]==='pending'||d.cam_s[1]==='waiting') camMap[c].furi++;
      if(d.delivery&&d.delivery.includes('未')) camMap[c].delivery++;
    });
  });
  document.getElementById('cam-tbody').innerHTML = Object.entries(camMap).sort((a,b)=>b[1].count-a[1].count).map(([cam,v])=>`<tr>
    <td style="font-weight:500">${cam}</td>
    <td class="amount">${v.count}</td>
    <td class="amount amount-cam">¥${v.cam.toLocaleString()}</td>
    <td class="amount amount-model">¥${v.model.toLocaleString()}</td>
    <td>${v.ringi>0?`<span class="st st-pending">${v.ringi}件</span>`:'<span class="st st-done">✓</span>'}</td>
    <td>${v.furi>0?`<span class="st st-pending">${v.furi}件</span>`:'<span class="st st-done">✓</span>'}</td>
    <td>${v.delivery>0?`<span class="st st-waiting">${v.delivery}件</span>`:'<span class="st st-done">✓</span>'}</td>
  </tr>`).join('');
}

// ============================================================
// MODAL
// ============================================================
const CAM_LABELS=['稟議','振込依頼','請求書受領','経理依頼','支払確認'];
const MOD_LABELS=['稟議','現場共有','請求書受領','支払'];
let camStatuses=['none','none','none','none','none'], modStatuses=['none','none','none','none'];

function buildStatusRow(id, labels, statuses) {
  var html = '';
  for (var i = 0; i < labels.length; i++) {
    var lbl = labels[i];
    var st = statuses[i];
    var isRingi = (lbl === '稟議');
    html += '<div class="status-item">';
    html += '<label>' + lbl + '</label>';
    html += '<div class="status-toggle">';
    html += '<button class="stbtn ' + (st==='done'?'active-done':'') + '" onclick="setStatus(\'' + id + '\',' + i + ',\'done\')">済</button>';
    html += '<button class="stbtn ' + (st==='pending'?'active-pending':'') + '" onclick="setStatus(\'' + id + '\',' + i + ',\'pending\')">未</button>';
    if (isRingi) {
      html += '<button class="stbtn ' + (st==='skip'?'active-skip':'') + '" onclick="setStatus(\'' + id + '\',' + i + ',\'skip\')">不要</button>';
    }
    html += '<button class="stbtn ' + (st==='none'?'active-none':'') + '" onclick="setStatus(\'' + id + '\',' + i + ',\'none\')">—</button>';
    html += '</div></div>';
  }
  document.getElementById(id).innerHTML = html;
}
function setStatus(id,idx,val) {
  if(id==='cam-status-row') camStatuses[idx]=val; else modStatuses[idx]=val;
  buildStatusRow(id,id==='cam-status-row'?CAM_LABELS:MOD_LABELS,id==='cam-status-row'?camStatuses:modStatuses);
}
function getTypeList() {
  const fixed = ['SNS','マルシェ','夜スパ','5周年'];
  const fromData = [...new Set(data.map(d=>d.type))].filter(Boolean);
  return [...new Set([...fixed, ...fromData])].sort();
}
function handleTypeSelect(sel) {
  const custom = document.getElementById('m-type-custom');
  custom.style.display = sel.value === '__new__' ? '' : 'none';
  if (sel.value !== '__new__') custom.value = '';
}
function getCamList() {
  return [...new Set(data.flatMap(d => d.cam.split('・').map(c=>c.trim())))].filter(Boolean).sort();
}
function getModelList() {
  return [...new Set(data.flatMap(d => (d.model||'').split(/[・,、]/).map(c=>c.trim())))].filter(c=>c&&c!=='なし'&&c!=='社内').sort();
}
function populateSelect(selId, items, currentVal) {
  const sel = document.getElementById(selId);
  const customId = selId + '-custom';
  const customEl = document.getElementById(customId);
  sel.innerHTML = '<option value="">選択してください</option>'
    + items.map(v=>'<option value="'+v+'"'+(v===currentVal?' selected':'')+'>'+v+'</option>').join('')
    + '<option value="__new__">＋ 新規追加...</option>';
  if (currentVal && !items.includes(currentVal)) {
    sel.value = '__new__';
    customEl.style.display = '';
    customEl.value = currentVal;
  } else {
    customEl.style.display = 'none';
  }
}
function handleCamSelect(sel) {
  const custom = document.getElementById('m-cam-custom');
  custom.style.display = sel.value === '__new__' ? '' : 'none';
  if (sel.value !== '__new__') custom.value = '';
}
function handleModelSelect(sel) {
  const custom = document.getElementById('m-model-custom');
  custom.style.display = sel.value === '__new__' ? '' : 'none';
  if (sel.value !== '__new__') custom.value = '';
}
function getSelectVal(selId) {
  const sel = document.getElementById(selId);
  if (sel.value === '__new__') return document.getElementById(selId+'-custom').value.trim();
  return sel.value;
}

function openModal(id=null) {
  editingId=id;
  document.getElementById('modal-title').textContent=id!==null?'案件編集':'新規案件追加';
  if(id!==null){
    const d=data.find(x=>x.id===id);
    document.getElementById('m-date').value=d.date;
    document.getElementById('m-facility').value=d.fac;
    document.getElementById('m-type').value=d.type;
    populateSelect('m-cam', getCamList(), d.cam);
    populateSelect('m-type', getTypeList(), d.type);
    document.getElementById('m-camfee').value=d.camFee;
    populateSelect('m-model', getModelList(), d.model||'');
    document.getElementById('m-modelfee').value=d.modelFee;
    document.getElementById('m-delivery').value=d.delivery;
    document.getElementById('m-note').value=d.note;
    camStatuses=[...d.cam_s]; modStatuses=[...d.mod_s];
  } else {
    document.getElementById('m-date').value=new Date().toISOString().split('T')[0];
    document.getElementById('m-facility').value='8F';
    document.getElementById('m-type').value='SNS';
    populateSelect('m-cam', getCamList(), '');
    populateSelect('m-type', getTypeList(), 'SNS');
    populateSelect('m-model', getModelList(), '');
    ['m-delivery','m-note'].forEach(i=>document.getElementById(i).value='');
    document.getElementById('m-camfee').value=0; document.getElementById('m-modelfee').value=0;
    camStatuses=['none','none','none','none','none']; modStatuses=['none','none','none','none'];
  }
  buildStatusRow('cam-status-row',CAM_LABELS,camStatuses);
  buildStatusRow('model-status-row',MOD_LABELS,modStatuses);
  document.getElementById('overlay').classList.add('open');
}
function closeModal() { document.getElementById('overlay').classList.remove('open'); }
function closeModalBg(e) { if(e.target===document.getElementById('overlay')) closeModal(); }
function saveItem() {
  const item = {
    id:editingId!==null?editingId:Date.now(),
    date:document.getElementById('m-date').value,
    fac:document.getElementById('m-facility').value,
    type:getSelectVal('m-type'),
    cam:getSelectVal('m-cam'),
    camFee:parseInt(document.getElementById('m-camfee').value)||0,
    model:getSelectVal('m-model'),
    modelFee:parseInt(document.getElementById('m-modelfee').value)||0,
    delivery:document.getElementById('m-delivery').value,
    note:document.getElementById('m-note').value,
    cam_s:[...camStatuses],mod_s:[...modStatuses],
  };
  if(editingId!==null){const idx=data.findIndex(x=>x.id===editingId);data[idx]=item;}
  else data.push(item);
  saveData(); closeModal(); renderAll();
}
function deleteItem(id) { if(!confirm('この案件を削除しますか？')) return; data=data.filter(x=>x.id!==id); saveData(); renderAll(); }

// ============================================================
// TABS
// ============================================================
const TABS=['list','monthly','payment','summary','camera'];
function switchTab(tab) {
  document.querySelectorAll('.tab').forEach((t,i)=>t.classList.toggle('active',TABS[i]===tab));
  TABS.forEach(t=>document.getElementById('tab-'+t).style.display=t===tab?'':'none');
  if(tab==='monthly') renderMonthly();
  if(tab==='payment') renderPayment();
  if(tab==='summary') renderSummary();
  if(tab==='camera') renderCamera();
}
function populateCamFilter() {
  const cams = [...new Set(data.flatMap(d=>d.cam.split('・').map(c=>c.trim())))].filter(Boolean).sort();
  const types = [...new Set(data.map(d=>d.type))].filter(Boolean).sort();
  const fys = [...new Set(data.map(d=>getFiscalYear(d.date.slice(0,7))))].sort((a,b)=>b-a);
  const fyOpts = fys.map(f=>'<option value="'+f+'">'+f+'年度</option>').join('');
  const camOpts = '<option value="">カメラマン すべて</option>'+cams.map(c=>'<option>'+c+'</option>').join('');
  const typeOpts = '<option value="">種別 すべて</option>'+types.map(t=>'<option>'+t+'</option>').join('');

  // LIST filters
  document.getElementById('f-cam').innerHTML = camOpts;
  document.getElementById('f-fy').innerHTML = '<option value="">年度 すべて</option>' + fyOpts;
  document.getElementById('f-type').innerHTML = typeOpts;

  // MONTHLY filters
  if(document.getElementById('mf-cam')) document.getElementById('mf-cam').innerHTML = camOpts;
  if(document.getElementById('mf-type')) document.getElementById('mf-type').innerHTML = typeOpts;

  // PAYMENT filter
  const payCams = Object.keys(payCycles);
  if(document.getElementById('pf-cam')) document.getElementById('pf-cam').innerHTML = '<option value="">カメラマン すべて</option>'+payCams.map(c=>'<option>'+c+'</option>').join('');

  // SUMMARY filter
  if(document.getElementById('sf-fy')) document.getElementById('sf-fy').innerHTML = '<option value="">年度 すべて</option>' + fyOpts;

  // CAMERA filter
  if(document.getElementById('cf-fy')) document.getElementById('cf-fy').innerHTML = '<option value="">年度 すべて</option>' + fyOpts;
}
function resetListFilters() {
  ['f-facility','f-cam','f-type','f-fy'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
  document.getElementById('f-search').value='';
  if(pendingOnly){ pendingOnly=false; document.getElementById('fb-pending').classList.remove('active'); }
  renderList();
}
function resetMonthlyFilters() {
  ['mf-facility','mf-cam','mf-type'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
  renderMonthly();
}
function resetPaymentFilters() {
  const el=document.getElementById('pf-cam'); if(el) el.value='';
  if(payPendingOnly){ payPendingOnly=false; document.getElementById('pfb-unpaid').classList.remove('active'); }
  renderPayment();
}
function resetSummaryFilters() {
  ['sf-fy','sf-facility'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
  renderSummary();
}
function resetCameraFilters() {
  ['cf-fy','cf-facility'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
  renderCamera();
}
function saveNote(id, el) {
  const d = data.find(x=>x.id===id);
  if(!d) return;
  d.note = el.innerText.trim();
  saveData();
}

function renderAll() { renderList(); populateCamFilter(); updateBadges(); }

loadData(); renderAll();
</script>
