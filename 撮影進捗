}

function updateBadges() {
  let ringi=0,furi=0,del=0;
  data.forEach(d=>{ if(d.cam_s[0]==='pending') ringi++; if(d.cam_s[1]==='pending'||d.cam_s[1]==='waiting') furi++; if(d.delivery&&d.delivery.includes('未')) del++; });
  document.getElementById('badge-ringi').textContent=ringi;
  document.getElementById('badge-furikomi').textContent=furi;
  document.getElementById('badge-delivery').textContent=del;
  document.getElementById('badge-total').textContent=data.length;
}

function togglePending() { pendingOnly=!pendingOnly; document.getElementById('fb-pending').classList.toggle('active',pendingOnly); renderList(); }

// ============================================================
// CSV EXPORT
// ============================================================
function exportCSV() {
  const filtered = getFiltered();
  const sl = s => s==='done'?'済':s==='pending'?'未':s==='waiting'?'待ち':'—';
  const headers = ['日付','施設','種別','カメラマン','カメラマン費用(税抜)','稟議','振込依頼','請求書受領','経理依頼','支払確認','モデル','モデル費用(税込)','モデル稟議','モデル現場共有','モデル請求書','モデル支払','納品状況','備考'];
  const rows = filtered.map(d => [
    d.date,d.fac,d.type,d.cam,d.camFee,
    sl(d.cam_s[0]),sl(d.cam_s[1]),sl(d.cam_s[2]),sl(d.cam_s[3]),sl(d.cam_s[4]),
    d.model,d.modelFee,
    sl(d.mod_s[0]),sl(d.mod_s[1]),sl(d.mod_s[2]),sl(d.mod_s[3]),
    d.delivery,d.note
  ].map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(','));
  const csv = '\uFEFF' + [headers.join(','),...rows].join('\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));
  a.download = `撮影進捗_${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
}

// ============================================================
// MONTHLY ARCHIVE
// ============================================================
function getFiscalYear(ym) {
  const [y, m] = ym.split('-').map(Number);
  return m >= 4 ? y : y - 1;
}
function fiscalKey(ym) {
  const [y,m] = ym.split('-').map(Number);
  return m >= 4 ? y * 100 + m : (y-1) * 100 + (m + 100);
}

let activeFY = null;

function renderMonthly() {
  const allFYs = [...new Set(data.map(d => getFiscalYear(d.date.slice(0,7))))].sort((a,b)=>b-a);
  if (activeFY === null || !allFYs.includes(activeFY)) activeFY = allFYs[0];

  const fyTabsHtml = '<div class="fy-tabs">' +
    allFYs.map(fy => '<button class="fy-tab' + (fy===activeFY?' active':'') + '" onclick="switchFY('+fy+')">' + fy + '年度</button>').join('') +
    '</div>';

  const sorted = [...data].sort((a,b)=>a.date<b.date?-1:1);
  const months = {};
  const mfFac = document.getElementById('mf-facility') ? document.getElementById('mf-facility').value : '';
  const mfCam = document.getElementById('mf-cam') ? document.getElementById('mf-cam').value : '';
  const mfType = document.getElementById('mf-type') ? document.getElementById('mf-type').value : '';
  sorted.forEach(d => {
    const ym = d.date.slice(0,7);
    if (getFiscalYear(ym) !== activeFY) return;
    if (mfFac && d.fac !== mfFac) return;
    if (mfCam && !d.cam.includes(mfCam)) return;
    if (mfType && d.type !== mfType) return;
    if (!months[ym]) months[ym] = [];
    months[ym].push(d);
  });

  const monthsHtml = Object.entries(months).sort((a,b)=>fiscalKey(b[0])-fiscalKey(a[0])).map(function(entry) {
    const ym = entry[0], items = entry[1];
    const totalCam = items.reduce((s,d)=>s+d.camFee,0);
    const totalModel = items.reduce((s,d)=>s+d.modelFee,0);
    const pending = items.filter(d=>d.cam_s.some(s=>s==='pending')||d.mod_s.some(s=>s==='pending')).length;
    const parts = ym.split('-');
    const label = parts[0] + '年' + parseInt(parts[1]) + '月';
    const rows = items.map(function(d) { return '<tr>'
      + '<td class="date-col" style="padding-left:14px">' + fmtDate(d.date) + '</td>'
      + '<td>' + facChip(d.fac) + '</td>'
      + '<td class="type-col">' + d.type + '</td>'
      + '<td style="font-size:12px">' + d.cam + '</td>'
      + '<td class="amount amount-cam">' + (d.camFee>0?'¥'+d.camFee.toLocaleString():'—') + '</td>'
      + '<td>' + stF(d.cam_s[0]) + '</td>'
      + '<td>' + stF(d.cam_s[1]) + '</td>'
      + '<td>' + stF(d.cam_s[4]) + '</td>'
      + '<td class="model-col">' + (d.model||'—') + '</td>'
      + '<td class="amount amount-model">' + (d.modelFee>0?'¥'+d.modelFee.toLocaleString():'—') + '</td>'
      + '<td>' + stF(d.mod_s[3]) + '</td>'
      + '<td class="delivery-col" title="' + (d.delivery||'') + '">' + (d.delivery||'—') + '</td>'
      + '</tr>';
    }).join('');
    return '<div class="month-block">'
      + '<div class="month-header" onclick="toggleMonth(\'' + ym + '\')">'
      + '<span class="month-label">' + label + '</span>'
      + '<span class="month-stats">'
      + '<span>' + items.length + '件</span>'
      + '<span style="color:var(--accent)">CAM ¥' + totalCam.toLocaleString() + '</span>'
      + '<span style="color:var(--accent3)">MODEL ¥' + totalModel.toLocaleString() + '</span>'
      + (pending>0 ? '<span style="color:var(--warn)">⚠ 未処理 '+pending+'件</span>' : '<span style="color:var(--ok)">✓ 完了</span>')
      + '</span>'
      + '<span class="month-toggle" id="mt-' + ym + '">▼</span>'
      + '</div>'
      + '<div class="month-body" id="mb-' + ym + '">'
      + '<table><thead><tr>'
      + '<th style="padding-left:14px">日付</th><th>施設</th><th>種別</th><th>カメラマン</th>'
      + '<th>費用(税抜)</th><th>稟議</th><th>振込</th><th>支払確認</th>'
      + '<th>モデル</th><th>モデル費用(税込)</th><th>モデル支払</th><th>納品</th>'
      + '</tr></thead><tbody>' + rows + '</tbody></table>'
      + '</div></div>';
  }).join('');

  document.getElementById('monthly-wrap').innerHTML = fyTabsHtml + monthsHtml;
}

function switchFY(fy) {
  activeFY = fy;
  renderMonthly();
}

function toggleMonth(ym) {
  const body = document.getElementById('mb-'+ym);
  const tog = document.getElementById('mt-'+ym);
  const isOpen = body.classList.contains('open');
  body.classList.toggle('open', !isOpen);
  tog.classList.toggle('open', !isOpen);
  tog.textContent = isOpen ? '▼' : '▲';
}

