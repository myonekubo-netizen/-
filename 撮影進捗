// HELPERS
function fmtDate(d) { return d.replace('2025-','25/').replace('2026-','26/').replace(/(\d{2})\/0?(\d+)/g,'$1/$2'); }
function stF(st, id, field, idx) {
  if (id !== undefined) {
    const oc = `onclick="toggleSt(${id},'${field}',${idx})"`;
    const cls = st==='done' ? 'st-done' : st==='pending' ? 'st-pending' : st==='waiting' ? 'st-waiting' : st==='skip' ? 'st-skip' : 'st-none';
    const lbl = st==='done' ? '✓' : st==='pending' ? '!' : st==='waiting' ? '⋯' : st==='skip' ? '不要' : '—';
    return `<span class="st ${cls}" style="cursor:pointer" title="クリックで切替" ${oc}>${lbl}</span>`;
  }
  if (st==='done')    return '<span class="st st-done">✓</span>';
  if (st==='pending') return '<span class="st st-pending">!</span>';
  if (st==='waiting') return '<span class="st st-waiting">⋯</span>';
  return '<span class="st st-none">—</span>';
}
function toggleSt(id, field, idx) {
  const d = data.find(x=>x.id===id);
  if (!d) return;
  d[field][idx] = d[field][idx]==='done' ? 'none' : 'done';
  saveData(); renderList();
}
function facChip(fac) { return `<span class="fac fac-${fac}">${fac}</span>`; }

