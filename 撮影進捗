let pendingOnly = false, editingId = null;

function getFiltered() {
  const fac = document.getElementById('f-facility').value;
  const cam = document.getElementById('f-cam').value;
  const type = document.getElementById('f-type').value;
  const fy = document.getElementById('f-fy') ? parseInt(document.getElementById('f-fy').value)||0 : 0;
  const search = document.getElementById('f-search').value.toLowerCase();
  return data.filter(d => {
    if (fac && d.fac !== fac) return false;
    if (cam && !d.cam.includes(cam)) return false;
    if (type && d.type !== type) return false;
    if (fy && getFiscalYear(d.date.slice(0,7)) !== fy) return false;
    if (search && !JSON.stringify(d).toLowerCase().includes(search)) return false;
    if (pendingOnly) {
      const hp = d.cam_s.some(s=>s==='pending'||s==='waiting') || d.mod_s.some(s=>s==='pending'||s==='waiting') || (d.delivery&&d.delivery.includes('未'));
      if (!hp) return false;
    }
    return true;
  }).sort((a,b)=>a.date<b.date?-1:1);
}

function renderList() {
  const filtered = getFiltered();
  const tbody = document.getElementById('tbody');
  const empty = document.getElementById('empty-msg');
